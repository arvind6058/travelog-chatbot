# Admin console configuration
# Copy to .env.local and adjust per environment.

# Base URL of the FastAPI backend (must end with /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Google Maps browser key. This key is public by design, but restrict it by
# HTTP referrer in Google Cloud Console — it appears in every map tile URL.
NEXT_PUBLIC_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
MAPS_PROVIDER=google
