# ==============================================================================
# TRAVELOGIX BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy to backend/.env — that is the ONLY env file the backend reads.
# Real environment variables always take precedence over this file.
# ==============================================================================

# Core Application Settings
PROJECT_NAME="TravelLogix"
VERSION="1.0.0"
# development | test | production
ENVIRONMENT="development"
# DEBUG must be false outside development; the app refuses to start otherwise.
DEBUG=false
# Logs every SQL statement WITH bound parameters (customer PII). Dev only.
SQL_ECHO=false

# Database
# Production: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# Local development fallback:
DATABASE_URL=sqlite+aiosqlite:///./travelogix.db

# Cache & Realtime (Redis). Optional: the app degrades without it, and the
# readiness probe reports it as a degraded feature rather than failing.
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Security & Sessions — REQUIRED, no insecure defaults
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_chars
# In production these two MUST differ (admin and customer tokens use different
# signing keys, so one leaked family cannot be replayed as the other).
CUSTOMER_SESSION_SECRET=replace_with_a_secure_customer_session_secret_key
ADMIN_SESSION_SECRET=replace_with_a_secure_admin_session_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ISSUER=travelogix
JWT_AUDIENCE=travelogix-api

# Brute-force protection on the authentication endpoints.
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------------------------
# Initial Administrator
# Provisioned as a real database row on first startup, hashed with bcrypt.
# The stored value is authoritative: to change an existing password use
#   python backend/scripts/rotate_admin_password.py
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@travelogix.internal
ADMIN_PASSWORD=AdminSecurePassword123!

# Frontend origins / absolute URLs (never hardcode hosts in code)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1
CUSTOMER_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
FRONTEND_BASE_URL=http://localhost:3000

# Development-only demo login (customer@example.com / Password123!).
# Refused in production by the startup validation.
ENABLE_DEMO_ACCOUNTS=false

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/customer/google/callback

# ------------------------------------------------------------------------------
# AI & LLM Providers
# LLM_PROVIDER: gemini | groq | openrouter | mock
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GROQ_MODEL=qwen/qwen3.8-27b
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# Travel Providers
# "mock" means demo data. When a provider is mock, replies are labelled as demo
# and any genuinely live value is reported as
# "Data unavailable from the configured provider" instead of being invented.
# ------------------------------------------------------------------------------
FLIGHT_PROVIDER=mock
FLIGHT_API_KEY=
TRAIN_PROVIDER=mock
TRAIN_API_KEY=
BUS_PROVIDER=mock
BUS_API_KEY=
HOTEL_PROVIDER=mock
HOTEL_API_KEY=
MAPS_PROVIDER=mock
MAPS_API_KEY=
WEATHER_PROVIDER=mock
WEATHER_API_KEY=
COURIER_PROVIDER=mock
COURIER_API_KEY=

# Regional defaults
DEFAULT_COUNTRY=INDIA
DEFAULT_CURRENCY=INR
