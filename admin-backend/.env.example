# Core Application Settings
PROJECT_NAME="TravelLogix"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/travelogix

# Cache & Realtime (Redis)
REDIS_URL=redis://localhost:6379/0

# Security & Sessions
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_chars
CUSTOMER_SESSION_SECRET=replace_with_a_secure_customer_session_secret_key
ADMIN_SESSION_SECRET=replace_with_a_secure_admin_session_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Credentials
ADMIN_EMAIL=admin@travelogix.internal
ADMIN_PASSWORD=AdminSecurePassword123!

# Frontend Origins (CORS)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# AI & LLM Providers
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Travel Providers
FLIGHT_PROVIDER=mock
FLIGHT_API_KEY=your_flight_api_key_here

TRAIN_PROVIDER=mock
TRAIN_API_KEY=your_train_api_key_here

BUS_PROVIDER=mock
BUS_API_KEY=your_bus_api_key_here

HOTEL_PROVIDER=mock
HOTEL_API_KEY=your_hotel_api_key_here

MAPS_PROVIDER=mock
MAPS_API_KEY=your_maps_api_key_here

WEATHER_PROVIDER=mock
WEATHER_API_KEY=your_weather_api_key_here

# Logistics Providers
COURIER_PROVIDER=mock
COURIER_API_KEY=your_courier_api_key_here

# Regional defaults
DEFAULT_COUNTRY=INDIA
DEFAULT_CURRENCY=INR
